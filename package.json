{
  "name": "aswaqi",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-engine.js && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "owner:create": "node --env-file-if-exists=.env scripts/create-owner.js",
    "password:reset": "node --env-file-if-exists=.env scripts/reset-password.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "dependencies": { "react": "19.2.6", "react-dom": "19.2.6", "lucide-react": "1.31.0" },
  "devDependencies": { "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@types/node": "22.19.19", "typescript": "5.9.3", "vite": "8.0.13", "@vitejs/plugin-react": "6.0.2" }
}
